# ---------------------------------------------------------------------------
# MarketLens configuration. Copy to `.env` and fill in. NEVER commit your .env.
# Every secret is read from the environment only — none is stored in the DB.
# ---------------------------------------------------------------------------

# --- Server mode ---
# solo  -> binds 127.0.0.1, no auth (single user on a laptop)
# team  -> binds 0.0.0.0, login required (shared LAN / VPS server)
MODE=solo
HOST=
PORT=8000

# --- Data directory (persistent). Docker mounts a volume here. ---
MARKETLENS_DATA_DIR=./data

# --- Team mode: admin bootstrap (created on first boot if no users exist) ---
ADMIN_USER=admin
ADMIN_PASSWORD=
# Signed-session secret. Set a long random value in team mode so sessions survive restart.
SESSION_SECRET=

# --- API keys (optional; the matching channel is skipped if unset) ---
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_PLACES_API_KEY=
TWITTER_API_KEY=

# --- Analysis models (configurable; sensible defaults) ---
ANALYSIS_MODEL=claude-haiku-4-5
VISION_MODEL=claude-haiku-4-5

# --- HTTP politeness ---
HTTP_RETRIES=3
RATE_LIMIT_SECONDS=1.5
HTTP_TIMEOUT=30
